{
  "name": "albedo",
  "private": true,
  "version": "1.3.0",
  "protocol": 3,
  "description": "Delegated transactions and messages signer for Stellar Network",
  "author": "StellarExpertTeam<info@stellar.expert>",
  "license": "MIT",
  "homepage": "https://github.com/stellar-expert/albedo",
  "bugs": {
    "url": "https://github.com/stellar-expert/albedo/issues",
    "email": "info@stellar.expert"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stellar-expert/albedo.git"
  },
  "scripts": {
    "build-app": "webpack --mode=production --config webpack-config.js",
    "watch-app": "webpack serve --mode=development --config webpack-config.js",
    "test": "jest"
  },
  "keywords": [
    "stellar",
    "signer",
    "SSO"
  ],
  "jest": {
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.pnpm|@stellar-expert|@noble|@exodus|uint8array-extras)/)"
    ],
    "moduleNameMapper": {
      "\\.(css|scss)$": "<rootDir>/test/style-mock.js"
    },
    "setupFiles": [
      "./test/setup-jest.js"
    ]
  },
  "dependencies": {
    "@albedo-link/intent": "file:../intent",
    "@stellar-broker/client": "0.8.0",
    "@stellar-expert/contract-wasm-interface-parser": "6.1.1",
    "@stellar-expert/formatter": "3.2.0",
    "@stellar-expert/liquidity-pool-utils": "1.0.3",
    "@stellar-expert/tx-meta-effects-parser": "10.1.1",
    "@stellar-expert/tx-signers-inspector": "3.0.0",
    "@stellar-expert/ui-framework": "3.1.0",
    "@stellar/stellar-sdk": "17.4.0",
    "@zxing/browser": "0.2.1",
    "aes-js": "3.1.2",
    "argon2-browser": "1.18.0",
    "bip39": "3.1.2",
    "classnames": "2.5.1",
    "mobx": "^6.6.2",
    "mobx-react": "^7.5.3",
    "prop-types": "15.8.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-fast-compare": "3.2.2",
    "throttle-debounce": "5.0.2",
    "vivus": "0.4.6"
  },
  "devDependencies": {
    "@stellar-expert/eslint-config-js": "^1.1.0",
    "@stellar-expert/eslint-config-react": "^1.1.0",
    "@stellar-expert/webpack-template": "1.5.1",
    "clone": "2.1.2",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-fetch-mock": "4.2.0"
  },
  "overrides": {
    "@stellar/stellar-sdk": "17.4.0",
    "@stellar-expert/tx-meta-effects-parser": "10.1.1"
  }
}
